{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:5173",
          "http://127.0.0.1:5173",
          "http://localhost:8788",
          "http://127.0.0.1:8788"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
